{
  "schemaVersion": 1,
  "id": "mistmod",
  "version": "${version}",
  "name": "Mist Mod",
  "description": "Swaps Dwarven Mines white stained glass to black and makes Ghosts visible as Creepers.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.mistmod.MistModClient"
    ]
  },
  "mixins": [
    "mistmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": ">=0.161.0"
  }
}
